rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validAppId(appId) {
      return appId.matches('^[A-Za-z0-9_\\-]{1,128}$');
    }

    function publishedApp(appId) {
      return firestore.exists(/databases/(default)/documents/apps/$(appId))
        && firestore.get(/databases/(default)/documents/apps/$(appId)).data.published == true;
    }

    match /releases/{appId}/{fileName} {
      allow read: if isAdmin()
        || (
          fileName.matches('^[A-Za-z0-9._\\-]{1,128}\\.apk$')
          && publishedApp(appId)
        );
      allow create, update: if isAdmin()
        && validAppId(appId)
        && fileName.matches('^[1-9][0-9]{0,9}\\.apk$')
        && request.resource.size > 0
        && request.resource.size <= 536870912
        && (
          request.resource.contentType == 'application/vnd.android.package-archive'
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType == 'application/zip'
        );
      allow delete: if isAdmin() && validAppId(appId);
    }

    match /icons/{appId}/{fileName} {
      allow read: if fileName.matches('^[A-Za-z0-9._\\-]{1,128}$')
        && fileName.size() < 129;
      allow create, update: if isAdmin()
        && validAppId(appId)
        && fileName.matches('^icon\\.(png|webp|jpg|jpeg)$')
        && request.resource.size > 0
        && request.resource.size <= 2097152
        && (
          request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
          || request.resource.contentType == 'image/jpeg'
        );
      allow delete: if isAdmin() && validAppId(appId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
